{
  "name": "talisman",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/api/server.ts",
    "start": "tsx src/api/server.ts",
    "dev:app": "vite --config app/vite.config.ts",
    "build:app": "vite build --config app/vite.config.ts",
    "typecheck:app": "tsc -p app/tsconfig.json",
    "worker": "tsx src/worker/main.ts",
    "migrate": "tsx src/db/migrate-cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:unit": "tsx --test --test-concurrency=1 tests/intelligence.test.ts tests/auth.test.ts tests/runtime.test.ts tests/serverless.test.ts tests/connectors.test.ts tests/db.test.ts tests/api.test.ts",
    "test:browser": "tsx --test --test-concurrency=1 tests/browser.smoke.test.ts",
    "test:e2e": "tsx --test --test-concurrency=1 tests/e2e.research.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@tanstack/react-query": "^5.106.1",
    "embedded-postgres": "^18.6.0-beta.19",
    "hono": "^4.10.0",
    "lucide-react": "^1.70.0",
    "motion": "^14.10.1",
    "pdf-lib": "^1.17.1",
    "pg": "^8.16.3",
    "playwright-core": "^1.56.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2",
    "vite": "^8.3.6"
  }
}
