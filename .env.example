# Talisman configuration. Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=3000
PUBLIC_URL=http://localhost:3000

# Postgres 16+. Required in production and on serverless hosts.
# Talisman migrates its own schema on start when TALISMAN_AUTO_MIGRATE=true.
DATABASE_URL=postgres://talisman:talisman@localhost:5432/talisman
TALISMAN_AUTO_MIGRATE=true

# 32+ byte secret used to sign session cookies. Required in production.
SESSION_SECRET=
# 32-byte base64 key used to encrypt provider credentials at rest. Required to store credentials.
CREDENTIAL_ENCRYPTION_KEY=

# Files produced by tasks live here. Each organisation gets its own subdirectory.
DATA_DIR=.data
# Artifact bytes: auto (fs locally, Postgres on Vercel), fs, or postgres.
TALISMAN_ARTIFACT_STORE=auto

# Model providers. Keys are read server-side only; they are never sent to clients.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
DEFAULT_MODEL=gpt-4.1-mini
# Comma-separated fallback chain, e.g. gpt-4.1-mini,claude-sonnet-4-20250514
MODEL_FALLBACKS=

# Web search for URL-less research goals: searxng (default) or apinex.
TALISMAN_SEARCH_PROVIDER=searxng
# SearXNG base URL, or https://api.apinex.bond/v1 for APInex.
TALISMAN_SEARCH_URL=
# Optional search key; APInex falls back to OPENAI_API_KEY.
TALISMAN_SEARCH_API_KEY=
# Extra hosts the browser may reach (comma separated). Empty means any public host.
BROWSER_ALLOWED_HOSTS=
# Allow the browser to reach loopback/private addresses. Tests only; never enable in production.
BROWSER_ALLOW_PRIVATE=false

# Page reader: auto (remote CDP if configured, HTTP on serverless, else Chromium),
# chromium, cdp, http or none.
TALISMAN_BROWSER_MODE=auto
# Remote Chromium over CDP, e.g. wss://production-sfo.browserless.io?token=...
BROWSER_WS_ENDPOINT=
TALISMAN_BROWSER_CHANNEL=chrome

# Shared secret for /api/internal/tick and /api/internal/migrate. Unset disables them.
CRON_SECRET=

# Google Calendar connector. Create an OAuth client (Web application) and add
# <PUBLIC_URL>/api/connectors/google/callback as an authorised redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional override when the redirect URI differs from the request origin.
GOOGLE_REDIRECT_URI=
# Wall-clock budget for one execution slice in milliseconds.
TALISMAN_MAX_RUN_MS=45000

# Worker
WORKER_ID=worker-1
WORKER_CONCURRENCY=2

# Phones (Phone Harness, MIT). See docs/PHONE-HARNESS.md.
PHONE_HARNESS_API_KEY=
PHONE_HARNESS_CLOUD_API=
PHONE_BRIDGE_URL=
PHONE_BRIDGE_TOKEN=
PHONE_DEFAULT_DEVICE=
