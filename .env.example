# Talisman configuration. Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=3000
PUBLIC_URL=http://localhost:3000

# Postgres 16+. Talisman migrates its own schema on start when TALISMAN_AUTO_MIGRATE=true.
DATABASE_URL=postgres://talisman:talisman@localhost:5432/talisman
TALISMAN_AUTO_MIGRATE=true

# 32+ byte secret used to sign session cookies. Required in production.
SESSION_SECRET=
# 32-byte base64 key used to encrypt provider credentials at rest. Required to store credentials.
CREDENTIAL_ENCRYPTION_KEY=

# Files produced by tasks live here. Each organisation gets its own subdirectory.
DATA_DIR=.data

# Model providers. Keys are read server-side only; they are never sent to clients.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
DEFAULT_MODEL=gpt-4.1-mini
# Comma-separated fallback chain, e.g. gpt-4.1-mini,claude-sonnet-4-20250514
MODEL_FALLBACKS=

# Optional SearXNG-compatible search endpoint used for web research.
TALISMAN_SEARCH_URL=
# Extra hosts the browser may reach (comma separated). Empty means any public host.
BROWSER_ALLOWED_HOSTS=
# Allow the browser to reach loopback/private addresses. Tests only; never enable in production.
BROWSER_ALLOW_PRIVATE=false

# Worker
WORKER_ID=worker-1
WORKER_CONCURRENCY=2
